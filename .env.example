# Copy this file to .env.local and fill in your values.
# At least one text provider is needed. Providers are tried in order with automatic fallback.

# Groq (primary for text: brand profile, directions, posts)
GROQ_API_KEY=your_groq_api_key_here
# Gemini (reads PDFs and screenshots; text backup)
GEMINI_API_KEY=your_gemini_api_key_here
# Anthropic Claude (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model overrides (comma-separated, tried in order)
# MODEL_CREATIVE_GROQ=openai/gpt-oss-120b,qwen/qwen3.8-27b
# MODEL_FAST_GROQ=openai/gpt-oss-20b,qwen/qwen3.8-27b
# MODEL_VISION_GEMINI=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-2.5-flash
# LOG_LLM_USAGE=1

# Optional: Supabase (for persistence in production)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# n8n backend: when set, /api/* routes forward to the "Brandly Backend" n8n workflow
# N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# N8N_WEBHOOK_SECRET=must_match_the_Brandly_Webhook_Secret_credential_in_n8n
